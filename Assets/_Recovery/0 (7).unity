    - target: {fileID: 1026795446916689469, guid: b32b8528ed778974caa1bd0176ec420c, type: 3}
      propertyPath: texteFinal
      value: "Il s\u2019agit de l\u2019histoire de Lho et Nik, deux jeunes h\xE9ros
        venus d\u2019une toute autre dimension. Ils ont \xE9t\xE9 envoy\xE9s en mission,
        mais pour l\u2019accomplir, ils doivent trouver un c\u0153ur pur et vaillant,
        quelqu\u2019un qui r\xE9pondra \xE0 leur appel\u2026 quelqu\u2019un qui r\xE9pondra
        \xE0 l\u2019\xC9tincelle."
      objectReference: {fileID: 0}
